{
  "tasks": {
    "lint": "deno lint",
    "lint:fix": "deno lint --fix",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "check": "deno check app.js",
    "validate": "deno task fmt:check && deno task lint && deno task check",
    "test": "deno test --allow-all app.test.ts",
    "test:property": "deno test --allow-all app.property.test.ts",
    "test:all": "deno test --allow-all app.test.ts app.property.test.ts",
    "test:coverage": "deno test --coverage=cov_profile --allow-all app.test.ts && deno coverage cov_profile --include=app.test.ts",
    "test:coverage:all": "deno test --coverage=cov_profile --allow-all app.test.ts app.property.test.ts && deno coverage cov_profile --include=app.test.ts,app.property.test.ts",
    "test:watch": "deno test --watch --allow-all app.test.ts",
    "bench": "deno bench --allow-net --no-check app.bench.ts"
  },
  "lint": {
    "include": ["app.js"],
    "exclude": ["wos.js", "wos_bg.wasm"],
    "rules": {
      "tags": ["recommended"],
      "include": [
        "ban-untagged-todo",
        "camelcase",
        "eqeqeq",
        "explicit-function-return-type",
        "no-await-in-loop",
        "no-const-assign",
        "no-debugger",
        "no-eval",
        "no-explicit-any",
        "no-sparse-arrays",
        "no-throw-literal",
        "no-unused-vars",
        "prefer-const"
      ]
    }
  },
  "fmt": {
    "include": ["app.js", "index.html", "style.css"],
    "exclude": ["wos.js"],
    "options": {
      "useTabs": false,
      "lineWidth": 100,
      "indentWidth": 2,
      "singleQuote": true,
      "proseWrap": "preserve"
    }
  },
  "test": {
    "include": ["app.test.ts", "app.property.test.ts"]
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true
  }
}
